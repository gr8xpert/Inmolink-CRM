      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket{job=\"feed-api\", http_route!~\"/readyz|/healthz\"}[5m]))))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      }
