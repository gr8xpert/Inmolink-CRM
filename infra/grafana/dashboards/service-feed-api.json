      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum_over_time(slo:sli_bad:increase1h{service=\"feed-api\", slo=\"availability\"}[30d]) / sum_over_time(slo:sli_total:increase1h{service=\"feed-api\", slo=\"availability\"}[30d])) / on (service, slo) (1 - slo:objective:ratio{service=\"feed-api\", slo=\"availability\"})",
