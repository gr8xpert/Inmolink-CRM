    {
      "id": 11,
      "title": "Public health probe (via Cloudflare)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "blackbox_exporter on the monitoring host; EndpointDown after 2 min.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(probe_success{job=\"blackbox\", service=\"feed-api\"})",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 6,
        "h": 4
      }
    },
