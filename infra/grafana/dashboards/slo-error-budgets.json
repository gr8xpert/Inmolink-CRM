{
  "title": "Inmolink · SLO error budgets",
  "uid": "inmolink-slo-error-budgets",
  "description": "S16-05 (PLAN §4.2, §17). Every SLO in infra/monitoring/rules/slo.yml: objective, budget left over 30 days (traffic-weighted: bad / total events), burn rates. Pages at 14.4× (1 h + 5 min), warns at 6× (6 h + 30 min).",
  "tags": ["inmolink", "slo"],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Budget left (30 days) per SLO",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum_over_time(slo:sli_bad:increase1h[30d]) / sum_over_time(slo:sli_total:increase1h[30d])) / on (service, slo) group_left () (1 - slo:objective:ratio)",
          "legendFormat": "{{service}} {{slo}}",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Burn rate (1 h) per SLO",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate1h / on (service, slo) group_left () (1 - slo:objective:ratio)",
          "legendFormat": "{{service}} {{slo}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Burn rate (6 h) per SLO",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate6h / on (service, slo) group_left () (1 - slo:objective:ratio)",
          "legendFormat": "{{service}} {{slo}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Bad share (5 min) per SLI",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate5m",
          "legendFormat": "{{service}} {{slo}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Objectives",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:objective:ratio",
          "legendFormat": "{{service}} {{slo}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Firing alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Slo.*\"}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      }
    }
  ]
}
