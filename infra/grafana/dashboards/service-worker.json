{
  "title": "Inmolink · Service · worker",
  "uid": "inmolink-service-worker",
  "description": "S16-05 (PLAN §17). Worker pools (apps/worker, job `worker`): queue age and depth per pool, job throughput and failures, feed health, freshness lag, matching, AI provider calls.",
  "tags": ["inmolink", "service:worker", "service"],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(inmolink_queue_wait_seconds_count, pool)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Queue age and depth per pool (queues.md)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Scraped worker processes up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"worker\"})",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 3,
      "title": "Worst pool wait p95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(histogram_quantile(0.95, sum by (le, pool) (rate(inmolink_queue_wait_seconds_bucket[5m]))))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 4,
      "title": "Oldest queued feed run",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inmolink_import_oldest_queued_seconds)",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 5,
      "title": "Jobs failed / s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bullmq_jobs_failed_total[5m]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 6,
      "title": "Queue wait p95 by pool (delivery pools: 30 s; others: 15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(inmolink_queue_wait_seconds_bucket{pool=~\"$pool\"}[5m])))",
          "legendFormat": "{{pool}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Jobs started / s by pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(inmolink_queue_wait_seconds_count{pool=~\"$pool\"}[5m]))",
          "legendFormat": "{{pool}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Jobs queued / s by queue (depth growth)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_waiting_total[5m]))",
          "legendFormat": "{{bullmq_queue_name}} waiting"
        },
        {
          "refId": "B",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_delayed_total[5m]))",
          "legendFormat": "{{bullmq_queue_name}} delayed"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Jobs completed / s by queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_completed_total[5m]))",
          "legendFormat": "{{bullmq_queue_name}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "title": "Jobs failed and retried / s by queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_failed_total[5m]))",
          "legendFormat": "{{bullmq_queue_name}} failed"
        },
        {
          "refId": "B",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_retried_total[5m]))",
          "legendFormat": "{{bullmq_queue_name}} retried"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 11,
      "title": "Job duration p95 by queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, bullmq_queue_name) (rate(bullmq_job_duration_bucket[5m])))",
          "legendFormat": "{{bullmq_queue_name}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Feed health and freshness (PLAN §4.2: feed change → ≤ 60 min after run)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 13,
      "title": "Oldest queued feed run",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inmolink_import_oldest_queued_seconds)",
          "legendFormat": "oldest"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 14,
      "title": "Feeds paused by the anomaly guard (15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(inmolink_import_paused_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 15,
      "title": "Edge purges failed (30 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "WebsiteEdgePurgeFailing (cdn.md › Purge failing).",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inmolink_website_edge_purge_failed_total[30m]))",
          "legendFormat": "failed"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 16,
      "title": "HMAC rotation: registrations pending rehash",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(inmolink_mls_fingerprint_rehash_pending)",
          "legendFormat": "pending"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "Matching and AI",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 18,
      "title": "Matching round engine time p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inmolink_network_match_round_ms_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 19,
      "title": "Buyer requests truncated (owners > 50 rounds) / h",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inmolink_network_match_truncated_total[1h]))",
          "legendFormat": "truncated"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 55,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 20,
      "title": "AI provider calls / s by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "AiProviderFailing above 50 % unavailable/circuit_open (ai-outage.md).",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(inmolink_ai_provider_calls_total{job=\"worker\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 63,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 21,
      "title": "AI usage records failing / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inmolink_ai_usage_record_failures_total{job=\"worker\"}[5m]))",
          "legendFormat": "record failures"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 63,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 22,
      "title": "Firing alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", alertname=~\".*Queue.*|Import.*|WebsiteEdgePurgeFailing|HmacRotationRehashPending|Ai.*|AppMetricsDown\"}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 0,
        "y": 71,
        "w": 24,
        "h": 6
      }
    }
  ]
}
