{
  "title": "Inmolink · Worker queues",
  "uid": "inmolink-worker-queues",
  "description": "Stub (S0-10). Job throughput, failures and duration per pool from BullMQ's OpenTelemetry metrics (worker WORKER_METRICS_PORT). Queue depth/age and outbox lag panels come with S0-15 alerting.",
  "tags": ["inmolink", "worker", "bullmq"],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} },
      {
        "name": "queue",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(bullmq_job_duration_count, bullmq_queue_name)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Jobs completed / s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_completed_total{bullmq_queue_name=~\"$queue\"}[5m]))",
          "legendFormat": "{{bullmq_queue_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Jobs failed / s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_failed_total{bullmq_queue_name=~\"$queue\"}[5m]))",
          "legendFormat": "{{bullmq_queue_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Job duration p95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, bullmq_queue_name) (rate(bullmq_job_duration_bucket{bullmq_queue_name=~\"$queue\"}[5m])))",
          "legendFormat": "{{bullmq_queue_name}}"
        }
      ]
    }
  ]
}
