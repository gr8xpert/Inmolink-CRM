# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    env: {{ inmolink_env }}
    # S16-05: rule annotations build `runbook_url` from it ($externalLabels.runbook_base) — a link in every notification.
    runbook_base: "{{ runbook_base_url }}"

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ wg_ip }}:9093"]

scrape_configs:
  - job_name: node
    static_configs:
{% for h in groups['all'] | unique %}
      - targets: ["{{ hostvars[h].wg_ip }}:{{ node_exporter_port }}"]
        labels: { instance: {{ h }}, host: {{ h }} }
{% endfor %}

  # `role` drives the replication alerts (infra/monitoring/rules/postgres.yml). After a failover, move
  # the hosts between db_primary/db_replica in the inventory and re-run the monitoring play.
  - job_name: postgres
    static_configs:
{% for h in groups['db_primary'] %}
      - targets: ["{{ hostvars[h].wg_ip }}:{{ postgres_exporter_port }}"]
        labels: { instance: {{ h }}, role: primary }
{% endfor %}
{% for h in groups['db_replica'] %}
      - targets: ["{{ hostvars[h].wg_ip }}:{{ postgres_exporter_port }}"]
        labels: { instance: {{ h }}, role: replica }
{% endfor %}

  # S7-F7: one redis_exporter per Redis — redis-queue on the db primary (Ansible role redis_queue; BullMQ and the
  # rate-limit counters, noeviction) and redis-cache on the app host (Kamal accessory redis-cache-exporter, LRU).
  # Feeds RedisMemoryHigh / RedisMemoryCritical (infra/monitoring/rules/redis.yml); `instance` names the Redis.
  - job_name: redis
    static_configs:
{% for h in groups['db_primary'] %}
      - targets: ["{{ hostvars[h].wg_ip }}:{{ redis_exporter_port }}"]
        labels: { instance: redis-queue, host: {{ h }} }
{% endfor %}
      # The one host that runs the api's redis-cache accessory (and its exporter): `redis_cache_host` per environment.
      - targets: ["{{ hostvars[redis_cache_host].wg_ip }}:{{ redis_cache_exporter_port }}"]
        labels: { instance: redis-cache, host: {{ redis_cache_host }} }

  # S16-F6: the apps (api, feed-api, realtime, worker), federated from each app host's app-metrics scraper
  # (roles/app_metrics: every Kamal container of a role by its network alias, so both containers of a rolling deploy).
  # The scraper's labels are kept (honor_labels): job = app, instance = container, host, kamal_role; `up` included, which
  # AppMetricsDown reads (infra/monitoring/rules/slo.yml). A scraper down: AppMetricsScraperDown (`host`); its containers'
  # series go stale, so AppMetricsDown follows only once no host's scraper sees a job (always, with one app host).
  - job_name: app-metrics
    honor_labels: true
    # Federated samples carry the scraper's timestamps, which Prometheus otherwise never marks stale: a container a
    # deploy stopped would stay in `up` and the dashboards for the 5-minute lookback.
    track_timestamps_staleness: true
    metrics_path: /federate
    params:
      "match[]": ['{job=~"api|feed-api|realtime|worker"}']
    static_configs:
{% for a in groups['app'] | unique %}
      - targets: ["{{ hostvars[a].wg_ip }}:{{ app_metrics_port }}"]
        labels: { host: {{ a }} }
{% endfor %}

  # S16-05: public health probes through Cloudflare (`endpoint_probes` per environment: every Kamal app's proxy host and
  # healthcheck path — tests/workspace/monitoring.test.ts keeps them in sync). `service` drives EndpointDown and the
  # uptime SLOs (infra/monitoring/rules/endpoints.yml, slo.yml); `instance` is the probed URL.
  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_health]
    scrape_interval: 30s
    static_configs:
{% for p in endpoint_probes %}
      - targets: ["{{ p.url }}"]
        labels: { service: {{ p.service }}, host: {{ p.host }} }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ wg_ip }}:{{ blackbox_exporter_port }}"

  # S16-05: the same health paths at each probe's origin (its app host's WireGuard address — the origin lock admits the
  # private network), Host header and SNI = the public host (`hostname` parameter): the origin certificate kamal-proxy
  # serves behind Cloudflare Full (strict). CertificateExpiringSoon / CertificateExpiryCritical read both jobs.
  - job_name: blackbox-origin
    metrics_path: /probe
    params:
      module: [http_origin]
    scrape_interval: 2m
    static_configs:
{% for p in endpoint_probes %}
      - targets: ["https://{{ hostvars[p.host].wg_ip }}{{ p.url | urlsplit('path') }}"]
        labels: { service: {{ p.service }}, host: {{ p.host }}, vhost: "{{ p.url | urlsplit('hostname') }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [vhost]
        target_label: __param_hostname
      - target_label: __address__
        replacement: "{{ wg_ip }}:{{ blackbox_exporter_port }}"
