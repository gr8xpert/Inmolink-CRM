# {{ ansible_managed }}
WALG_S3_PREFIX={{ walg_s3_prefix }}
AWS_ENDPOINT=https://{{ vault_r2_account_id }}.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID={{ vault_r2_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ vault_r2_secret_access_key }}
WALG_COMPRESSION_METHOD=zstd
WALG_LIBSODIUM_KEY={{ vault_walg_libsodium_key }}
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_UPLOAD_CONCURRENCY=8
WALG_DOWNLOAD_CONCURRENCY=8
WALG_RETAIN_FULL={{ walg_retain_full }}
PGHOST=/var/run/postgresql
PGUSER=postgres
