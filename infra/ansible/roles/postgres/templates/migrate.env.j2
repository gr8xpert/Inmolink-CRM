# {{ ansible_managed }}
# Read by scripts/ops/deploy.sh: `docker run --env-file /etc/inmolink/migrate.env <worker image> node packages/db/dist/cli/deploy.js`
# on the primary's host. Owner credentials never reach the app hosts. DATABASE_URL_ADMIN is never stored
# here: deploy.sh --bootstrap-roles sends it over stdin from the operator's shell.
NODE_ENV=production
APP_ROLE=script
LOG_LEVEL=info
DATABASE_URL_APP_OWNER=postgres://app_owner:{{ vault_db_app_owner_password }}@127.0.0.1:{{ postgres_port }}/{{ postgres_db }}
DATABASE_URL_APP_USER=postgres://app_user:{{ vault_db_app_user_password }}@127.0.0.1:{{ pgbouncer_port }}/{{ postgres_db }}
DATABASE_URL_APP_SYSTEM=postgres://app_system:{{ vault_db_app_system_password }}@127.0.0.1:{{ pgbouncer_port }}/{{ postgres_db }}
DATABASE_URL_APP_PUBLIC=postgres://app_public:{{ vault_db_app_public_password }}@127.0.0.1:{{ pgbouncer_port }}/{{ postgres_db }}
DATABASE_URL_APP_AUTH=postgres://app_auth:{{ vault_db_app_auth_password }}@127.0.0.1:{{ pgbouncer_port }}/{{ postgres_db }}
DATABASE_URL_APP_STAFF=postgres://app_staff:{{ vault_db_app_staff_password }}@127.0.0.1:{{ pgbouncer_port }}/{{ postgres_db }}
