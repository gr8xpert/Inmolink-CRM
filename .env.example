# Copy to .env for local development. Never commit .env.
# Ports and local credentials match the `dev` profile in docker-compose.yml (`pnpm infra:up`).
# Real values arrive with the tasks that use them (validated at boot by platform/config, S0-03).

NODE_ENV=development
# http | worker | script — withSystem() is refused when APP_ROLE=http (S0-04)
APP_ROLE=http
LOG_LEVEL=info

# PostgreSQL via PgBouncer (S0-04) — one URL per role; roles are created in S0-04
DATABASE_URL_APP_USER=postgres://app_user:change-me@localhost:6432/inmolink
DATABASE_URL_APP_SYSTEM=postgres://app_system:change-me@localhost:6432/inmolink
DATABASE_URL_APP_PUBLIC=postgres://app_public:change-me@localhost:6432/inmolink
DATABASE_URL_APP_OWNER=postgres://app_owner:change-me@localhost:5432/inmolink
# Bootstrap superuser — ops scripts and health checks only, never the app runtime
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/inmolink
DATABASE_URL_ADMIN_POOLED=postgres://postgres:postgres@localhost:6432/inmolink

# Redis — queue (noeviction, AOF) and cache (allkeys-lru)
REDIS_QUEUE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=local-dev-master-key

# Object storage — MinIO locally, Cloudflare R2 in production (S1-03)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=inmolink
S3_SECRET_ACCESS_KEY=inmolink-local-secret
S3_BUCKET_MEDIA=inmolink-media
S3_BUCKET_EXPORTS=inmolink-exports

# Email — Mailpit catches everything locally (S0-09)
SMTP_URL=smtp://localhost:1025
MAILPIT_URL=http://localhost:8025

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_HEALTH_URL=http://localhost:13133
JAEGER_UI_URL=http://localhost:16686
