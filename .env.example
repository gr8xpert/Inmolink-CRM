# Copy to .env for local development. Never commit .env.
# Ports and local credentials match the `dev` profile in docker-compose.yml (`pnpm infra:up`).
# Real values arrive with the tasks that use them (validated at boot by platform/config, S0-03).

NODE_ENV=development
# http | worker | script — withSystem() is refused when APP_ROLE=http (S0-04)
APP_ROLE=http
LOG_LEVEL=info

# PostgreSQL via PgBouncer — one URL per role. `pnpm db:migrate` creates/updates the roles with these
# passwords (via DATABASE_URL_ADMIN). DATABASE_URL_APP_SYSTEM (BYPASSRLS) is refused for APP_ROLE=http in production.
DATABASE_URL_APP_USER=postgres://app_user:change-me@localhost:6432/inmolink
DATABASE_URL_APP_SYSTEM=postgres://app_system:change-me@localhost:6432/inmolink
DATABASE_URL_APP_PUBLIC=postgres://app_public:change-me@localhost:6432/inmolink
# Identity tables only (sign-up, login, reset, access tokens); no tenant data (S0-09, ADR 0004)
DATABASE_URL_APP_AUTH=postgres://app_auth:change-me@localhost:6432/inmolink
# Staff request paths (verification queue, staff console); RLS on, staff predicates only (S1-03, ADR 0015). api only.
DATABASE_URL_APP_STAFF=postgres://app_staff:change-me@localhost:6432/inmolink
# The media worker's narrow role (S3-F4): media_objects and property_media.sha256 only.
DATABASE_URL_APP_MEDIA=postgres://app_media:change-me@localhost:6432/inmolink
DATABASE_URL_APP_OWNER=postgres://app_owner:change-me@localhost:5432/inmolink
# Bootstrap superuser — ops scripts and health checks only, never the app runtime
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/inmolink
DATABASE_URL_ADMIN_POOLED=postgres://postgres:postgres@localhost:6432/inmolink

# HTTP apps (S0-08). Each app pins its own APP_ROLE (api/feed-api/realtime → http, worker → worker).
# HOST=0.0.0.0 in containers. TRUST_PROXY: false | hop count (1 behind kamal-proxy) | CIDR list — never true.
HOST=127.0.0.1
TRUST_PROXY=false
# Header the CDN/edge sets with its request id (e.g. cf-ray); a client-sent x-request-id is never trusted.
# EDGE_REQUEST_ID_HEADER=
API_PORT=4000
FEED_API_PORT=4001
REALTIME_PORT=4002
WORKER_HEALTH_PORT=4003
# Worker pools for this process: all | comma list (outbox, imports, media, indexing, matching, exports, email, ai, social, pdf, maintenance)
WORKER_POOLS=all
# Next.js: web on 3100, public on 3101 (package scripts; 3000–3002 clash with other local projects)

# Redis — queue (noeviction, AOF) and cache (allkeys-lru)
REDIS_QUEUE_URL=redis://localhost:6381
REDIS_CACHE_URL=redis://localhost:6380
# Rate-limit counters (S1-F6): redis-queue, which never evicts. Production uses an ACL user limited to inl:rl:*.
REDIS_LIMITS_URL=redis://localhost:6381

# Search
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=local-dev-master-key
# Search-only key for api/feed-api (S1-F5): production refuses MEILI_MASTER_KEY in request apps.
# MEILI_SEARCH_KEY=

# Object storage — MinIO locally, Cloudflare R2 in production (S1-03)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=inmolink
S3_SECRET_ACCESS_KEY=inmolink-local-secret
S3_BUCKET_MEDIA=inmolink-media
S3_BUCKET_EXPORTS=inmolink-exports
# Private documents (agency verification, S1-03): never public, read only through short signed URLs.
S3_BUCKET_PRIVATE=inmolink-private
# Media originals and masters (S3-F9): never public; the media worker's credentials cover it, not the private bucket.
S3_BUCKET_MEDIA_WORK=inmolink-media-work

# Email — Mailpit catches everything locally (S0-09). EMAIL_DRIVER: smtp (Mailpit, Amazon SES SMTP) | resend (RESEND_API_KEY)
EMAIL_DRIVER=smtp
EMAIL_FROM=Inmolink <no-reply@inmolink.local>
SMTP_URL=smtp://localhost:1025
MAILPIT_URL=http://localhost:8025

# Auth (S0-09). WEB_URL: dashboard base URL (email links, CORS / socket origin allowlist).
# API_URL: where web's server calls the dashboard API. AUTH_SECRET encrypts the Auth.js session cookie.
WEB_URL=http://localhost:3100
API_URL=http://localhost:4000
# MAP_STYLE_URL: MapLibre style JSON for the staff taxonomy editor map (default: MapLibre demo tiles).
# MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
AUTH_SECRET=dev-P7U9zqzYvnRL38PwBgXH3LqIdqLN3IDtvyLOnitUOJE
# Cloudflare Turnstile (S1-F5): the login challenge past the per-email ceiling. Unset = hard block.
# Cloudflare's always-pass test keys work locally and are refused in production.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Access tokens (15 min, Ed25519): web signs, api/realtime verify. LOCAL DEV KEYS — ids "dev…" are refused in production.
AUTH_JWT_KEY_ID=dev-1
AUTH_JWT_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIIokFZlFPiG5rY8/BikaWmui4W0LMkhhDR3/KrGI9+cd
AUTH_JWT_PUBLIC_KEYS=dev-1:MCowBQYDK2VwAyEA57hG/H5HUDaL1k17CeMBqE03zTvNPgLVHoX7DKSYyqs=

# Observability (S0-10). Spans → OTLP/HTTP collector → Jaeger; unset the endpoint to stop exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Share of new traces kept (0–1). Required in production (e.g. 0.05). Internet-facing apps re-sample client-sent traceparents.
OTEL_TRACES_SAMPLE_RATIO=1
# Prometheus /metrics per app, on a private interface only. 0 turns an app's endpoint off.
# Production: loopback or a private address; 0.0.0.0 only with METRICS_ALLOW_WILDCARD=true (unpublished container port).
METRICS_HOST=127.0.0.1
# METRICS_ALLOW_WILDCARD=false
API_METRICS_PORT=9464
FEED_API_METRICS_PORT=9465
REALTIME_METRICS_PORT=9466
WORKER_METRICS_PORT=9467
# Errors → Sentry (unset: logged only). RELEASE = build id (git SHA) on errors and spans; DEPLOY_ENV defaults to NODE_ENV.
# SENTRY_DSN=
# DEPLOY_ENV=staging
RELEASE=dev
OTEL_COLLECTOR_HEALTH_URL=http://localhost:13133
JAEGER_UI_URL=http://localhost:16686

# Encryption (platform/crypto) — LOCAL DEV VALUES ONLY; production keys live in the secret store.
# ENCRYPTION_KEYS: comma-separated keyId:base64(32 bytes). Rotate: add a key, switch the active id,
# re-encrypt, then drop the old key. New key: openssl rand -base64 32
ENCRYPTION_KEYS=dev1:gOid8c3Gq/xDngwo9zS6C1RbtlAac+1xxS+dcK8Kfak=
ENCRYPTION_ACTIVE_KEY_ID=dev1
# Dedicated HMAC-SHA256 key (fingerprints, idempotency keys), >= 32 chars. Ids "dev…" and HMAC keys "dev-…" are refused when NODE_ENV=production.
HMAC_KEY=dev-01c1d8e276ba8bfe3a373a947be2a96c5706827172d0449d9dac51abbe9b621b
# Media variant URLs (S3-04, worker): >= 32 chars, its own key, kept for good (rotating it moves every URL).
MEDIA_URL_KEY=dev-5b0e2f7c91d34a6e8f1c0b9d2a7e4f6153c8d9e0a1b2c3d4e5f60718293a4b5c
