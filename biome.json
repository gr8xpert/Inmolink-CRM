{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["./packages/config/biome.preset.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/next-env.d.ts",
      "!apps/wp-plugin",
      "!graphify-out",
      "!packages/db/migrations",
      "!**/*.generated.ts"
    ]
  }
}
