{
  "name": "inmolink",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm infra:up && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "lint": "turbo run lint lint:root",
    "lint:root": "biome check --files-ignore-unknown=true package.json turbo.json biome.json tsconfig.json vitest.config.ts scripts tests/workspace tests/infra tests/isolation tests/queue tests/adapters tests/apps tests/perf tests/e2e playwright.config.ts",
    "format": "biome check --write .",
    "test": "turbo run test test:root",
    "test:root": "vitest run --project workspace",
    "test:int": "turbo run test:int test:int:root",
    "test:int:root": "vitest run --project infra --project queue && vitest run --project adapters && vitest run --project apps",
    "test:perf:root": "vitest run --project perf",
    "verify": "turbo run typecheck typecheck:root lint lint:root test test:root test:int test:int:root test:isolation test:perf:root --affected",
    "verify:all": "turbo run typecheck typecheck:root lint lint:root test test:root test:int test:int:root test:isolation test:perf:root",
    "infra:up": "docker compose --profile dev up -d --wait",
    "infra:up:test": "docker compose --profile test up -d --wait",
    "infra:down": "docker compose --profile dev --profile test down",
    "infra:health": "tsx scripts/ops/health.ts",
    "infra:health:test": "tsx scripts/ops/health.ts --test",
    "ops:replay-outbox": "tsx --conditions=@inmolink/source scripts/ops/replay-outbox.ts",
    "db:generate": "pnpm --filter @inmolink/db db:generate",
    "db:migrate": "pnpm --filter @inmolink/db db:migrate",
    "db:migrate:test": "pnpm --filter @inmolink/db db:migrate --test",
    "db:rls": "pnpm --filter @inmolink/db db:rls",
    "db:rls:test": "pnpm --filter @inmolink/db db:rls --test",
    "db:seed": "node scripts/stub.mjs db:seed S0-13",
    "db:seed:scale": "node scripts/stub.mjs db:seed:scale S0-13",
    "gen:module": "node scripts/stub.mjs gen:module S0-12",
    "check:boundaries": "node scripts/stub.mjs check:boundaries S0-12",
    "test:isolation": "vitest run --project isolation",
    "test:e2e": "turbo run build --filter=@inmolink/app-web^... && playwright test",
    "perf:smoke": "node scripts/stub.mjs perf:smoke",
    "i18n:draft": "node scripts/stub.mjs i18n:draft S0-11",
    "ai:eval": "node scripts/stub.mjs ai:eval S12-01",
    "sdk:generate": "node scripts/stub.mjs sdk:generate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inmolink/app-api": "workspace:*",
    "@inmolink/app-feed-api": "workspace:*",
    "@inmolink/app-realtime": "workspace:*",
    "@inmolink/app-worker": "workspace:*",
    "@inmolink/config": "workspace:*",
    "@inmolink/db": "workspace:*",
    "@inmolink/platform": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "husky": "9.1.7",
    "ioredis": "6.0.0",
    "lint-staged": "17.6.0",
    "pg": "8.23.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
