{
  "name": "@inmolink/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared UI components and design tokens.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@inmolink/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test"
  },
  "dependencies": {
    "@inmolink/contracts": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inmolink/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
