{
  "name": "@inmolink/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Infrastructure adapters (cache, queue, outbox, search, storage, email, ai, crypto, ...).",
  "sideEffects": [
    "./src/telemetry/register.ts",
    "./dist/telemetry/register.js"
  ],
  "exports": {
    ".": {
      "@inmolink/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "@inmolink/source": "./src/cache/index.ts",
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./clock": {
      "@inmolink/source": "./src/clock/index.ts",
      "types": "./dist/clock/index.d.ts",
      "default": "./dist/clock/index.js"
    },
    "./config": {
      "@inmolink/source": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./crypto": {
      "@inmolink/source": "./src/crypto/index.ts",
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./crypto/password": {
      "@inmolink/source": "./src/crypto/password.ts",
      "types": "./dist/crypto/password.d.ts",
      "default": "./dist/crypto/password.js"
    },
    "./email": {
      "@inmolink/source": "./src/email/index.ts",
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./errors": {
      "@inmolink/source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./flags": {
      "@inmolink/source": "./src/flags/index.ts",
      "types": "./dist/flags/index.d.ts",
      "default": "./dist/flags/index.js"
    },
    "./http": {
      "@inmolink/source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./ids": {
      "@inmolink/source": "./src/ids/index.ts",
      "types": "./dist/ids/index.d.ts",
      "default": "./dist/ids/index.js"
    },
    "./jwt": {
      "@inmolink/source": "./src/jwt/index.ts",
      "types": "./dist/jwt/index.d.ts",
      "default": "./dist/jwt/index.js"
    },
    "./logger": {
      "@inmolink/source": "./src/logger/index.ts",
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./outbox": {
      "@inmolink/source": "./src/outbox/index.ts",
      "types": "./dist/outbox/index.d.ts",
      "default": "./dist/outbox/index.js"
    },
    "./queue": {
      "@inmolink/source": "./src/queue/index.ts",
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./rate-limit": {
      "@inmolink/source": "./src/rate-limit/index.ts",
      "types": "./dist/rate-limit/index.d.ts",
      "default": "./dist/rate-limit/index.js"
    },
    "./server": {
      "@inmolink/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./telemetry": {
      "@inmolink/source": "./src/telemetry/index.ts",
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./telemetry/register": {
      "@inmolink/source": "./src/telemetry/register.ts",
      "types": "./dist/telemetry/register.d.ts",
      "default": "./dist/telemetry/register.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-zod": "1.0.0",
    "@inmolink/contracts": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/node": "11.6.0",
    "bullmq": "6.3.12",
    "bullmq-otel": "2.0.1",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.1.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inmolink/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "fastify": "5.12.5",
    "openapi-types": "12.1.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "fastify": "^5.12.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
