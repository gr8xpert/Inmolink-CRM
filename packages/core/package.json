{
  "name": "@inmolink/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "All business logic, one folder per module.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@inmolink/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./modules/*": {
      "@inmolink/source": "./src/modules/*/index.ts",
      "types": "./dist/modules/*/index.d.ts",
      "default": "./dist/modules/*/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test"
  },
  "dependencies": {
    "@inmolink/contracts": "workspace:*",
    "@inmolink/db": "workspace:*",
    "@inmolink/i18n": "workspace:*",
    "@inmolink/platform": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inmolink/config": "workspace:*",
    "@types/node": "24.19.2",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
