# Kamal secrets (S0-15). Copy to .kamal/secrets.staging and .kamal/secrets.production — both git-ignored.
# Kamal reads .kamal/secrets-common first, then .kamal/secrets.<destination>. Values are taken from the
# environment of whoever runs the deploy (operator shell or the GitHub Actions deploy environment), so
# these files hold references, not secrets: KEY=$KEY. Never paste real values into the repo.
#
# Database URLs point at PgBouncer (6432) on the primary's WireGuard address. Passwords match
# infra/ansible vault_db_app_*_password.
# After a failover, change the host part to the new primary and redeploy (docs/runbooks/failover.md).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RELEASE=$RELEASE
SENTRY_DSN=$SENTRY_DSN

DATABASE_URL_APP_USER=$DATABASE_URL_APP_USER
DATABASE_URL_APP_SYSTEM=$DATABASE_URL_APP_SYSTEM
DATABASE_URL_APP_PUBLIC=$DATABASE_URL_APP_PUBLIC
DATABASE_URL_APP_AUTH=$DATABASE_URL_APP_AUTH
DATABASE_URL_APP_STAFF=$DATABASE_URL_APP_STAFF
DATABASE_URL_APP_MEDIA=$DATABASE_URL_APP_MEDIA
REDIS_QUEUE_URL=$REDIS_QUEUE_URL
# The media container (S3-F7) as the `media` ACL user, which reaches only its own BullMQ keys:
# redis://media:<vault_redis_media_password>@<db-1 WireGuard IP>:6379.
REDIS_QUEUE_URL_MEDIA=$REDIS_QUEUE_URL_MEDIA
# Rate-limit counters on redis-queue as the `limits` ACL user (S1-F6), which reaches only inl:rl:* keys:
# redis://limits:<vault_redis_limits_password>@<db-1 WireGuard IP>:6379.
REDIS_LIMITS_URL=$REDIS_LIMITS_URL
# redis-cache accessory AUTH (S1-F5); REDIS_CACHE_URL=redis://:<password>@inmolink-api-redis-cache:6379.
REDIS_CACHE_PASSWORD=$REDIS_CACHE_PASSWORD
REDIS_CACHE_URL=$REDIS_CACHE_URL
# Master key: the meilisearch accessory and the worker only. Request apps get the search-only key
# (create it once per deployment — docs/runbooks/deploy.md).
MEILI_MASTER_KEY=$MEILI_MASTER_KEY
MEILI_SEARCH_KEY=$MEILI_SEARCH_KEY
# Cloudflare Turnstile widget for the login challenge (S1-F5, H3). Test keys are refused in production.
TURNSTILE_SITE_KEY=$TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=$TURNSTILE_SECRET_KEY

AUTH_SECRET=$AUTH_SECRET
AUTH_JWT_KEY_ID=$AUTH_JWT_KEY_ID
AUTH_JWT_PRIVATE_KEY=$AUTH_JWT_PRIVATE_KEY
AUTH_JWT_PUBLIC_KEYS=$AUTH_JWT_PUBLIC_KEYS
ENCRYPTION_KEYS=$ENCRYPTION_KEYS
ENCRYPTION_ACTIVE_KEY_ID=$ENCRYPTION_ACTIVE_KEY_ID
HMAC_KEY=$HMAC_KEY
MEDIA_URL_KEY=$MEDIA_URL_KEY

SMTP_URL=$SMTP_URL
S3_ENDPOINT=$S3_ENDPOINT
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
# The media container's own R2 token (S3-F7): inmolink-media + inmolink-media-work only (S3-F9) (docs/runbooks/deploy.md).
S3_MEDIA_ACCESS_KEY_ID=$S3_MEDIA_ACCESS_KEY_ID
S3_MEDIA_SECRET_ACCESS_KEY=$S3_MEDIA_SECRET_ACCESS_KEY
S3_BUCKET_PRIVATE=$S3_BUCKET_PRIVATE
EMAIL_FROM=$EMAIL_FROM

# Cloudflare origin certificate for *.inmolink.es (PEM, multi-line: export from a file).
CLOUDFLARE_ORIGIN_CERT_PEM=$CLOUDFLARE_ORIGIN_CERT_PEM
CLOUDFLARE_ORIGIN_KEY_PEM=$CLOUDFLARE_ORIGIN_KEY_PEM
