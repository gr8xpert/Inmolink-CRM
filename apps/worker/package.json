{
  "name": "@inmolink/app-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ processors, one entry per pool.",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch --conditions=@inmolink/source --import @inmolink/platform/telemetry/register src/main.ts",
    "start": "node --import @inmolink/platform/telemetry/register dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test"
  },
  "dependencies": {
    "@inmolink/contracts": "workspace:*",
    "@inmolink/core": "workspace:*",
    "@inmolink/platform": "workspace:*",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inmolink/config": "workspace:*",
    "@inmolink/db": "workspace:*",
    "@types/node": "24.19.2",
    "ioredis": "6.0.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
