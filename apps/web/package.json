{
  "name": "@inmolink/app-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js dashboard (agency, agent, developer, staff console).",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3100",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --passWithNoTests int.test"
  },
  "dependencies": {
    "@inmolink/contracts": "workspace:*",
    "@inmolink/core": "workspace:*",
    "@inmolink/i18n": "workspace:*",
    "@inmolink/platform": "workspace:*",
    "@inmolink/ui": "workspace:*",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inmolink/config": "workspace:*",
    "@inmolink/db": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
