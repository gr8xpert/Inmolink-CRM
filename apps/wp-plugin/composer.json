{
  "name": "inmolink/wp-plugin",
  "description": "Inmolink listings for WordPress (website API v2). Dev dependencies only: the plugin ships with no runtime Composer packages.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-sodium": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "roots/wordpress-no-content": "6.8.*",
    "wp-coding-standards/wpcs": "^3.1",
    "wp-phpunit/wp-phpunit": "6.8.*",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "fix": "phpcbf"
  }
}
