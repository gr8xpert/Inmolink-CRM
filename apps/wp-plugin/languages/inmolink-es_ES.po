#: src/Admin/Health.php:105
msgid "Off — this server has no cURL transport, so the API is not called: pages are served from the cache only"
msgstr "Desactivado: este servidor no tiene transporte cURL, así que no se llama a la API; las páginas se sirven solo desde la caché"

#: src/Admin/Health.php:105
msgid "Off — requests go through an HTTP proxy, which resolves the API address (it is checked before each request but not pinned)"
msgstr "Desactivado: las peticiones pasan por un proxy HTTP, que resuelve la dirección de la API (se comprueba antes de cada petición, pero no se fija)"

#: src/Admin/Health.php:163
msgid "Inmolink serves cached listings only: this server has no cURL transport"
msgstr "Inmolink solo sirve inmuebles en caché: este servidor no tiene transporte cURL"

#: src/Admin/LegacyProxyNotice.php:48
msgid "Inmolink: INMOLINK_TRUSTED_PROXY_HEADER without INMOLINK_TRUSTED_PROXIES is deprecated and will stop being read in a future version. Add your proxy's address ranges to wp-config.php as INMOLINK_TRUSTED_PROXIES, so the visitor address is only read from requests your proxy forwarded."
msgstr "Inmolink: INMOLINK_TRUSTED_PROXY_HEADER sin INMOLINK_TRUSTED_PROXIES está obsoleto y dejará de leerse en una versión futura. Añade los rangos de direcciones de tu proxy a wp-config.php como INMOLINK_TRUSTED_PROXIES, para que la dirección del visitante solo se lea de las peticiones reenviadas por tu proxy."

#: src/Updates/Updater.php:353
