# Dependencies & build output
node_modules/
dist/
apps/*/build/
packages/*/build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# Env & secrets — never commit
.env
.env.*
!.env.example
!.env.test.example
secrets/
*.pem
*.key

# Data — legacy dumps and real client data stay outside the repo
*.sql.gz
*.dump
*.bak
dumps/

# Local tooling
.claude/settings.local.json
CLAUDE.local.md
graphify-out/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Next.js generated
next-env.d.ts
test-results/
playwright-report/

# Ops secrets (S0-15): Ansible vault files and Kamal secrets live only on the operator's machine
infra/ansible/inventories/*/group_vars/all/vault.yml
.kamal/secrets*
!.kamal/secrets.example
restore-drill-*.json
