# Integration tests. Ports match the `test` profile in docker-compose.yml — never the dev ones,
# so tests cannot touch dev data. Copy to .env.test to override locally; tests fall back to this file.

NODE_ENV=test
APP_ROLE=http
LOG_LEVEL=warn
# No span export or /metrics servers in tests (tests that need them start their own).
METRICS_HOST=127.0.0.1
API_METRICS_PORT=0
FEED_API_METRICS_PORT=0
REALTIME_METRICS_PORT=0
WORKER_METRICS_PORT=0

DATABASE_URL_APP_USER=postgres://app_user:change-me@localhost:56432/inmolink
DATABASE_URL_APP_SYSTEM=postgres://app_system:change-me@localhost:56432/inmolink
DATABASE_URL_APP_PUBLIC=postgres://app_public:change-me@localhost:56432/inmolink
DATABASE_URL_APP_AUTH=postgres://app_auth:change-me@localhost:56432/inmolink
# Staff request paths (verification queue, staff console); RLS on, staff predicates only (S1-03, ADR 0015). api only.
DATABASE_URL_APP_STAFF=postgres://app_staff:change-me@localhost:56432/inmolink
DATABASE_URL_APP_MEDIA=postgres://app_media:change-me@localhost:56432/inmolink
DATABASE_URL_APP_OWNER=postgres://app_owner:change-me@localhost:55432/inmolink
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:55432/inmolink
DATABASE_URL_ADMIN_POOLED=postgres://postgres:postgres@localhost:56432/inmolink

REDIS_QUEUE_URL=redis://localhost:56379
REDIS_CACHE_URL=redis://localhost:56380
REDIS_LIMITS_URL=redis://localhost:56379

MEILI_URL=http://localhost:57700
MEILI_MASTER_KEY=local-dev-master-key

S3_ENDPOINT=http://localhost:59000
S3_REGION=auto
S3_ACCESS_KEY_ID=inmolink
S3_SECRET_ACCESS_KEY=inmolink-local-secret
S3_BUCKET_MEDIA=inmolink-media
S3_BUCKET_EXPORTS=inmolink-exports
# Private documents (agency verification, S1-03): never public, read only through short signed URLs.
S3_BUCKET_PRIVATE=inmolink-private
# Media originals and masters (S3-F9): never public; the media worker's credentials cover it, not the private bucket.
S3_BUCKET_MEDIA_WORK=inmolink-media-work

EMAIL_DRIVER=smtp
EMAIL_FROM=Inmolink <no-reply@inmolink.test>
SMTP_URL=smtp://localhost:51025
MAILPIT_URL=http://localhost:58025

# Auth (S0-09) — TEST VALUES ONLY. Ports match the Playwright stack (tests/e2e).
WEB_URL=http://localhost:54110
