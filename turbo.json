{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#typecheck:root": {},
    "//#lint:root": {},
    "//#test:root": {},
    "//#test:int:root": {
      "dependsOn": ["^test:int", "//#test:isolation"],
      "cache": false
    },
    "//#test:perf:root": {
      "dependsOn": [
        "^typecheck",
        "^lint",
        "^test",
        "^test:int",
        "//#typecheck:root",
        "//#lint:root",
        "//#test:root",
        "//#test:int:root",
        "//#test:isolation"
      ],
      "cache": false
    },
    "//#test:isolation": {
      "cache": false
    }
  }
}
