{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-widget/**", ".next/**", "!.next/cache/**", "public/maplibre/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#typecheck:root": {},
    "//#lint:root": {},
    "//#test:root": {},
    "//#check:boundaries": {
      "cache": false
    },
    "//#test:boundaries": {
      "dependsOn": ["^test:int", "//#test:int:root", "//#test:isolation"],
      "cache": false
    },
    "//#test:int:root": {
      "dependsOn": ["^test:int", "//#test:isolation"],
      "cache": false
    },
    "//#test:perf:root": {
      "dependsOn": [
        "@inmolink/core#build",
        "^typecheck",
        "^lint",
        "^test",
        "^test:int",
        "//#typecheck:root",
        "//#lint:root",
        "//#test:root",
        "//#check:boundaries",
        "//#test:boundaries",
        "//#test:int:root",
        "//#test:isolation"
      ],
      "cache": false
    },
    "//#test:isolation": {
      "dependsOn": [
        "^test:int",
        "@inmolink/db#test:int",
        "@inmolink/core#test:int",
        "@inmolink/app-api#test:int",
        "@inmolink/app-web#test:int",
        "@inmolink/app-worker#test:int",
        "@inmolink/app-feed-api#test:int"
      ],
      "cache": false
    }
  }
}
